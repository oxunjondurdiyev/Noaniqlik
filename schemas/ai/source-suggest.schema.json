{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "uc-ai/source-suggest/1",
  "title": "AI: manba taklifi",
  "description": "E'tibordan chetda qolishi mumkin bo'lgan manbalar — faqat nom va tur, QIYMATSIZ.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "suggestions"
  ],
  "properties": {
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input",
          "name",
          "kind",
          "distribution",
          "why"
        ],
        "properties": {
          "input": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "certificate",
              "specification",
              "resolution",
              "drift",
              "environment",
              "procedure",
              "reference",
              "sample_variability",
              "other"
            ]
          },
          "distribution": {
            "enum": [
              "normal",
              "rect",
              "triang",
              "ushape",
              "resol",
              "trap",
              "ctrap",
              "exp",
              "lognorm",
              "unknown"
            ]
          },
          "why": {
            "type": "string"
          }
        }
      }
    }
  }
}
