{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://uncertaintycalc/schemas/methodology.schema.json",
  "title": "UncertaintyCalc metodika (o'lchash noaniqligi shabloni) — uc-template/1",
  "description": "Shablon: o'lchash modeli, kirishlar, B tur manbalari, o'zgarmaslar, variantlar, korrelyatsiyalar, metama'lumot. Hisob: src/templates/interpreter.js → modelSpec (uc-model/1; REGRESSION rejimida uc-regression/1) → evaluate(). Yo'riqnoma: docs/TEMPLATE_GUIDE.md.",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "status", "domain", "section", "evaluationMode", "title", "standards", "measurand", "model", "inputs", "typeBSources", "ref"],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "P08: evaluationMode = REGRESSION bo'lsa `regression` bo'limi majburiy (kalibrlash egri chizig'i; hisob: buildRegressionSpec → uc-regression/1 → evaluate()).",
      "if": { "required": ["evaluationMode"], "properties": { "evaluationMode": { "const": "REGRESSION" } } },
      "then": { "required": ["regression"] }
    },
    {
      "$comment": "P09: evaluationMode = TOP_DOWN bo'lsa `topDown` bo'limi majburiy (usta sozlamalari; hisob: buildTopDownState → usta → uc-topdown/1 → evaluate()).",
      "if": { "required": ["evaluationMode"], "properties": { "evaluationMode": { "const": "TOP_DOWN" } } },
      "then": { "required": ["topDown"] }
    },
    {
      "$comment": "P10: maxsus rejimlar (SAMPLING, QUALITATIVE, MICROBIOLOGY, MEDICAL) — `special` bo'limi majburiy (hisob: buildSpecialState → \"Maxsus rejimlar\" oynasi → evaluate()).",
      "if": { "required": ["evaluationMode"], "properties": { "evaluationMode": { "enum": ["SAMPLING", "QUALITATIVE", "MICROBIOLOGY", "MEDICAL"] } } },
      "then": { "required": ["special"] }
    }
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "uc-template/1" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$", "maxLength": 64 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["DRAFT", "REVIEWED", "APPROVED", "RETIRED"] },
    "domain": { "enum": ["CALIBRATION", "TESTING"] },
    "section": { "enum": ["calibration", "construction", "food_chem", "electrical", "general"] },
    "field": { "type": "string" },
    "evaluationMode": { "enum": ["GUM_BOTTOM_UP", "REGRESSION", "TOP_DOWN", "QUALITATIVE", "SAMPLING", "MICROBIOLOGY", "MEDICAL"] },
    "isEmpiricalMeasurand": { "type": "boolean" },
    "title": { "$ref": "#/definitions/text" },
    "description": { "$ref": "#/definitions/text" },
    "standards": { "type": "array", "items": { "$ref": "#/definitions/standard" } },
    "labCount": { "type": ["integer", "null"], "minimum": 0 },
    "sourceNote": { "$ref": "#/definitions/text" },
    "ref": { "type": "string", "minLength": 1 },
    "openQuestions": { "type": "array", "items": { "$ref": "#/definitions/openQuestion" } },
    "expectedWarnings": {
      "type": "array",
      "items": {
        "type": "object", "required": ["code", "reason"], "additionalProperties": false,
        "properties": { "code": { "type": "string" }, "reason": { "$ref": "#/definitions/text" } }
      }
    },
    "measurand": {
      "type": "object", "required": ["symbol", "name", "unit"], "additionalProperties": false,
      "properties": {
        "symbol": { "$ref": "#/definitions/symbol" },
        "name": { "$ref": "#/definitions/text" },
        "unit": { "type": "string" }
      }
    },
    "model": {
      "type": "object", "required": ["formula"], "additionalProperties": false,
      "properties": {
        "formula": { "type": "string" },
        "note": { "$ref": "#/definitions/text" }
      }
    },
    "outputs": {
      "$comment": "P07: qo'shimcha chiqish kattaliklari (vektor model, JCGM 102:2011 §6.2). Birinchi chiqish — measurand + model.formula; bu yerda ikkinchi va keyingilari. Mavjud shablonlarda bu maydon yo'q — ular o'zgarmagan.",
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "required": ["symbol", "formula"], "additionalProperties": false,
        "properties": {
          "symbol": { "$ref": "#/definitions/symbol" },
          "name": { "$ref": "#/definitions/text" },
          "unit": { "type": "string" },
          "formula": { "type": "string" }
        }
      }
    },
    "implicit": {
      "$comment": "P07b: oshkor bo'lmagan model h(Y, X) = 0 (JCGM 102:2011 §6.3). unknowns — chiqish kattaliklari (birinchisi — measurand.symbol); start — boshlang'ich yaqinlashuv y⁽⁰⁾ ning STANDART qiymati (egasi qarori 2026-11-19: y⁽⁰⁾ majburiy, shablon standart qiymat bera oladi; foydalanuvchi o'zgartirishi mumkin; berilmasa — foydalanuvchi kiritadi, dastur o'ylab topmaydi). equations — tenglamalar (h = 0 yoki 'chap = o'ng'), soni unknowns soniga teng. Bunday shablonda model.formula bo'sh, variants yo'q.",
      "type": "object", "required": ["unknowns", "equations"], "additionalProperties": false,
      "properties": {
        "unknowns": {
          "type": "array", "minItems": 1, "maxItems": 20,
          "items": {
            "type": "object", "required": ["symbol"], "additionalProperties": false,
            "properties": {
              "symbol": { "$ref": "#/definitions/symbol" },
              "name": { "$ref": "#/definitions/text" },
              "unit": { "type": "string" },
              "start": { "type": ["number", "null"] }
            }
          }
        },
        "equations": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } }
      }
    },
    "variants": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/variant" } },
    "defaultVariant": { "type": "string" },
    "constants": { "type": "array", "items": { "$ref": "#/definitions/constant" } },
    "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/input" } },
    "typeBSources": { "type": "array", "items": { "$ref": "#/definitions/typeBSource" } },
    "correlations": { "type": "array", "items": { "$ref": "#/definitions/correlation" } },
    "directions": { "type": "array", "items": { "enum": ["↑", "↓", ""] } },
    "sampleData": { "$ref": "#/definitions/sampleData" },
    "points": { "type": "array", "items": { "$ref": "#/definitions/point" } },
    "settings": { "$ref": "#/definitions/settings" },
    "regression": { "$ref": "#/definitions/regression" },
    "topDown": { "$ref": "#/definitions/topDown" },
    "validationBasis": { "$ref": "#/definitions/validationBasis" },
    "special": { "$ref": "#/definitions/special" },
    "decisionRule": { "$ref": "#/definitions/decisionRule" },
    "reporting": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "reportType": { "enum": ["calibration_certificate", "test_report", "budget"] },
        "rounding": { "enum": ["normal", "up"] }
      }
    },
    "locked": { "type": "array", "items": { "enum": ["model", "variants", "constants", "inputs", "typeBSources", "correlations", "settings", "decisionRule", "measurand"] }, "uniqueItems": true },
    "legacyPresetKey": { "type": "string" },
    "author": { "type": "string" },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "history": {
      "type": "array",
      "items": {
        "type": "object", "required": ["at", "status"], "additionalProperties": false,
        "properties": {
          "at": { "type": "string" }, "status": { "enum": ["DRAFT", "REVIEWED", "APPROVED", "RETIRED"] },
          "by": { "type": "string" }, "version": { "type": "string" }, "note": { "type": "string" }
        }
      }
    }
  },
  "definitions": {
    "text": {
      "description": "Uch tildagi matn (CLAUDE.md: barcha foydalanuvchi matnlari uz/ru/en)",
      "type": "object", "required": ["uz", "ru", "en"], "additionalProperties": false,
      "properties": {
        "uz": { "type": "string", "minLength": 1 },
        "ru": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "validationBasis": {
      "description": "P12: validatsiya natijasidan tuzilgan TOP_DOWN qoralamasining raqamli asosi (faqat foydalanuvchi shablonida; builtin shablonda taqiqlangan — checkTemplate). sourceHash — manba ma'lumotlarning RFC 8785 SHA-256 xeshi.",
      "type": "object", "required": ["source", "sourceHash", "date", "precision"], "additionalProperties": false,
      "properties": {
        "source": { "const": "validation" },
        "sourceHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "precision": {
          "type": "object", "required": ["test", "sI", "sr", "sb", "nuSr"], "additionalProperties": false,
          "properties": {
            "test": { "type": "string" }, "sI": { "type": "number", "minimum": 0 }, "sr": { "type": "number", "minimum": 0 }, "sb": { "type": "number", "minimum": 0 },
            "nuSr": { "type": "number", "minimum": 1 }, "nuSI": { "type": "number", "exclusiveMinimum": 0 }, "nuSIRule": { "enum": ["welch_satterthwaite", "negative_component"] }, "k": { "type": "integer", "minimum": 2 }, "N": { "type": "integer", "minimum": 2 }, "negativeComponent": { "type": "boolean" }
          }
        },
        "recovery": {
          "type": "object", "required": ["test", "Rm", "s", "n", "uRm"], "additionalProperties": false,
          "properties": {
            "test": { "type": "string" }, "Rm": { "type": "number" }, "s": { "type": "number", "minimum": 0 }, "n": { "type": "integer", "minimum": 2 },
            "uRm": { "type": "number", "minimum": 0 }, "significant": { "type": "boolean" }, "relativeUnit": { "enum": ["%", "1"] }
          }
        }
      }
    },
    "symbol": { "type": "string", "pattern": "^[^\\s+\\-*/^()=,.0-9√][^\\s+\\-*/^()=,√]*$", "maxLength": 32 },
    "number_or_expr": {
      "description": "Son, kirish o'rtachalaridan formula (\"0.0002*I + 0.002\") yoki null — foydalanuvchi kiritadi",
      "type": ["number", "string", "null"]
    },
    "standard": {
      "type": "object", "required": ["code"], "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "clause": { "type": "string" },
        "edition": { "type": ["string", "null"] },
        "labCount": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "openQuestion": {
      "type": "object", "required": ["id", "text", "owner"], "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^Q\\d+$" },
        "text": { "$ref": "#/definitions/text" },
        "owner": { "enum": ["lab", "owner", "lab+owner"] },
        "blocking": { "type": "boolean" }
      }
    },
    "variant": {
      "type": "object", "required": ["id", "title", "formula", "inputs"], "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "title": { "$ref": "#/definitions/text" },
        "formula": { "type": "string", "minLength": 1 },
        "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/symbol" }, "uniqueItems": true },
        "constants": { "type": "object", "additionalProperties": { "type": ["number", "null"] } },
        "standards": { "type": "array", "items": { "$ref": "#/definitions/standard" } },
        "measurand": {
          "type": "object", "required": ["symbol", "name", "unit"], "additionalProperties": false,
          "properties": { "symbol": { "$ref": "#/definitions/symbol" }, "name": { "$ref": "#/definitions/text" }, "unit": { "type": "string" } }
        },
        "excludeSources": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "decisionRule": { "$ref": "#/definitions/decisionRule" },
        "note": { "$ref": "#/definitions/text" }
      }
    },
    "constant": {
      "description": "O'zgarmas (noaniqligi 0, standart jadvalidan yoki ta'rif bo'yicha). value = null — laboratoriya standartdan kiritadi.",
      "type": "object", "required": ["symbol", "name", "unit", "value", "ref"], "additionalProperties": false,
      "properties": {
        "symbol": { "$ref": "#/definitions/symbol" },
        "name": { "$ref": "#/definitions/text" },
        "unit": { "type": "string" },
        "value": { "type": ["number", "null"] },
        "ref": {
          "description": "Qiymat manbasi. Faqat belgi (standart raqami, 'EURACHEM QUAM A2') — satr; izohli matn bo'lsa — uch tildagi matn (P05, R-13).",
          "anyOf": [{ "type": "string", "minLength": 1 }, { "$ref": "#/definitions/text" }]
        },
        "hint": { "$ref": "#/definitions/text" }
      }
    },
    "input": {
      "type": "object", "required": ["symbol", "name", "unit", "kind"], "additionalProperties": false,
      "properties": {
        "symbol": { "$ref": "#/definitions/symbol" },
        "name": { "$ref": "#/definitions/text" },
        "unit": { "type": "string" },
        "kind": { "enum": ["observation", "reference", "influence", "nominal"] },
        "typeA": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "method": { "enum": [1, 2, 3] },
            "sp": { "type": ["number", "null"] },
            "nup": { "type": ["number", "null"] },
            "directional": { "type": "boolean" },
            "pooledAllowed": { "type": "boolean" }
          }
        },
        "hint": { "$ref": "#/definitions/text" }
      }
    },
    "typeBSource": {
      "type": "object", "required": ["id", "input", "name", "kind", "distribution", "halfWidth"], "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
        "input": { "$ref": "#/definitions/symbol" },
        "name": { "$ref": "#/definitions/text" },
        "legacyName": { "type": "string" },
        "kind": { "enum": ["certificate", "specification", "resolution", "drift", "environment", "procedure", "reference", "sample_variability", "other"] },
        "distribution": { "enum": ["normal", "rect", "triang", "ushape", "resol", "trap", "ctrap", "exp", "lognorm"] },
        "allowedDistributions": { "type": "array", "items": { "enum": ["normal", "rect", "triang", "ushape", "resol", "trap", "ctrap", "exp", "lognorm"] }, "uniqueItems": true },
        "halfWidth": { "$ref": "#/definitions/number_or_expr" },
        "k": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "beta": { "type": "number", "minimum": 0, "maximum": 1 },
        "d": { "$ref": "#/definitions/number_or_expr" },
        "nu": { "type": ["number", "null"] },
        "sensitivity": { "type": ["number", "null"] },
        "unit": { "type": "string" },
        "instrument": { "type": "string" },
        "correlated": { "type": "boolean" },
        "includeByDefault": { "type": "boolean" },
        "share": { "description": "P04b: asbob kalibrlash manbasining qismi — 'common' (ofset/sezgirlik, korrelyatsiyaga kiradi) yoki 'point' (nuqtaga xos, hech qachon covB ga kirmaydi)", "enum": ["common", "point"] },
        "certificateU": { "description": "P04b: sertifikatdagi to'liq U (ixtiyoriy; ikki marta hisoblash tekshiruvi uchun, faqat share = 'common')", "type": ["number", "null"] },
        "certificateK": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "hint": { "$ref": "#/definitions/text" },
        "note": { "$ref": "#/definitions/text" }
      }
    },
    "correlation": {
      "description": "Bitta asbob bilan o'lchangan kirishlar orasidagi korrelyatsiya (umumiy sistematik ta'sir). u(xi,xj) = r·u_X(xi)·u_X(xj), u_X — shu asbobning korrelyatsiyalangan manbalari. Ref: JCGM 100:2008 §5.2.2, F.1.2.3.",
      "type": "object", "required": ["id", "inputs", "r"], "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
        "inputs": { "type": "array", "minItems": 2, "items": { "$ref": "#/definitions/symbol" }, "uniqueItems": true },
        "r": { "type": ["number", "null"], "minimum": -1, "maximum": 1 },
        "sharedInstrument": { "type": "string" },
        "ask": { "type": "boolean" },
        "defaultEnabled": { "type": "boolean" },
        "split": { "description": "P04b: 'known' — sertifikat umumiy va nuqtaga xos qismga bo'lingan (covB faqat umumiy qismdan); 'unknown' — faqat to'liq U ma'lum, r = 0 va r = 1 hisoblanib katta u_c olinadi (loyiha qarori). Yo'q bo'lsa — P04 dagi eski format (migrateTemplate → 'unknown').", "enum": ["known", "unknown"] },
        "question": { "$ref": "#/definitions/text" },
        "note": { "$ref": "#/definitions/text" }
      }
    },
    "sampleData": {
      "type": "object", "required": ["demo", "data"], "additionalProperties": false,
      "properties": {
        "demo": { "type": "boolean" },
        "note": { "$ref": "#/definitions/text" },
        "source": { "type": "string" },
        "data": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": ["number", "string"] } } }
      }
    },
    "point": {
      "type": "object", "required": ["label", "data"], "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "demo": { "type": "boolean" },
        "data": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": ["number", "string"] } } },
        "patch": {
          "type": "object",
          "additionalProperties": {
            "type": "object", "additionalProperties": false,
            "properties": { "halfWidth": { "$ref": "#/definitions/number_or_expr" }, "k": { "type": ["number", "null"] }, "distribution": { "enum": ["normal", "rect", "triang", "ushape", "resol", "trap", "ctrap", "exp", "lognorm"] } }
          }
        }
      }
    },
    "settings": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "P": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "kMethod": { "enum": ["nu", "k2"] },
        "nuRule": { "enum": ["floor", "interpolate", "exact"] },
        "paired": { "type": "boolean" },
        "secondOrder": { "type": "boolean" },
        "rounding": { "enum": ["normal", "up"] },
        "modelKind": { "enum": ["error", "value", "unknown"], "description": "Model natijasi: error — ko'rsatish xatosi E = X − X_ref; value — kattalik qiymati Y (nominal bilan). Muvofiqlik bayonoti uchun majburiy (RISKS R-07)." },
        "nominal": { "type": ["number", "string"], "description": "modelKind = value uchun nominal qiymat (MPE bilan |Y − nominal| solishtiriladi)" },
        "mpe": { "type": ["number", "string"] },
        "range": { "type": ["number", "string"] },
        "cmc": { "type": ["number", "string"] },
        "typeA": { "type": "object" }
      }
    },
    "regression": {
      "description": "REGRESSION rejimi (P08): kalibrlash egri chizig'i y = a + b·(x − xRef) [+ c·(x − xRef)² + d·(x − xRef)³]. x va y — inputs[] dagi belgilar. Raqamli maydonlar (kalibrlash nuqtalari, y₀, u) shablonda bo'sh; namunaviy ma'lumot faqat demo: true bilan.",
      "type": "object", "required": ["method", "degree", "x", "y", "calibrationPoints"], "additionalProperties": false,
      "properties": {
        "method": { "enum": ["OLS", "WLS", "WTLS", "GLS"] },
        "allowedMethods": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["OLS", "WLS", "WTLS", "GLS"] } },
        "degree": { "enum": [1, 2, 3] },
        "xRef": { "type": ["number", "null"] },
        "x": { "$ref": "#/definitions/symbol" },
        "y": { "$ref": "#/definitions/symbol" },
        "sigma": { "enum": ["auto", "prior", "posterior"] },
        "chi2P": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "calibrationPoints": {
          "type": "array",
          "items": {
            "type": "object", "required": ["x", "y"], "additionalProperties": false,
            "properties": {
              "x": { "type": ["number", "null"] }, "ux": { "type": ["number", "null"] },
              "y": { "type": ["number", "null"] }, "uy": { "type": ["number", "null"] }
            }
          }
        },
        "demo": { "type": "boolean" },
        "demoNote": { "$ref": "#/definitions/text" },
        "demoSource": { "type": "string" },
        "inverse": {
          "type": "object", "required": ["enabled"], "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "replicates": { "type": ["integer", "null"], "minimum": 1 },
            "y0": { "type": "array", "items": { "type": "number" } },
            "uy0": { "type": ["number", "null"] },
            "hint": { "$ref": "#/definitions/text" }
          }
        },
        "predict": {
          "type": "object", "required": ["enabled"], "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "x": { "type": "array", "items": { "type": "number" } },
            "hint": { "$ref": "#/definitions/text" }
          }
        },
        "uRange": {
          "type": "object", "required": ["mode"], "additionalProperties": false,
          "properties": { "mode": { "enum": ["linear", "max"] } }
        },
        "hint": { "$ref": "#/definitions/text" }
      },
      "allOf": [
        {
          "$comment": "Shablonda raqam bo'lsa — faqat namunaviy ma'lumot sifatida (demo: true)",
          "if": { "required": ["calibrationPoints"], "properties": { "calibrationPoints": { "minItems": 1 } } },
          "then": { "required": ["demo"], "properties": { "demo": { "const": true } } }
        }
      ]
    },
    "topDown": {
      "description": "TOP_DOWN rejimi (P09): validatsiya va sifat nazorati ma'lumotlaridan noaniqlik. Shablon faqat usta sozlamalarini beradi (ma'lumot turi, shkala, nazorat namunasi qamraydigan omillar, qamralmagan qo'shimcha hissalar ro'yxati). Raqamli maydonlar yo'q: qo'shimcha hissalarning u qiymati har doim null — laboratoriya kiritadi.",
      "type": "object", "required": ["basis", "scale"], "additionalProperties": false,
      "properties": {
        "basis": { "enum": ["within", "sR", "level"] },
        "rwSources": { "type": "array", "uniqueItems": true, "items": { "enum": ["control_series", "duplicates", "control_limits", "stated"] } },
        "biasSource": { "enum": ["none", "crm", "pt", "recovery", "recovery_quam"] },
        "scale": { "enum": ["relative", "absolute"] },
        "covers": { "type": "array", "uniqueItems": true, "items": { "enum": ["repeatability", "intermediate_precision", "reproducibility", "balance", "volumetric", "calibration", "reference_material", "recovery", "matrix", "homogeneity", "sampling", "sample_preparation", "temperature", "time", "speed", "operator", "instrument", "drift", "other"] } },
        "additional": {
